# ── Supabase (Member B) ──
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_KEY=eyJ...         # Service role key (Supabase dashboard → Settings → API)

# ── GitHub App (webhook + PR comments) ──
GITHUB_APP_ID=
GITHUB_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----"
GITHUB_WEBHOOK_SECRET=               # python -c "import secrets; print(secrets.token_hex(32))"

# ── GitHub OAuth App (frontend private repo access) ──
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=

# ── LLM API (pick one or more) ──
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# ── Scoring ──
FAIL_UNDER_SCORE=70
